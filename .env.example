# Comma-separated lists. Keep searches relevant to your needs.
SEARCH_QUERIES=Python Engineer,Python Developer,AI Engineer,Machine Learning Engineer,Generative AI Engineer,LLM Engineer,Data Scientist,Data Engineer,Backend Developer,Full Stack Developer,Software Engineer,MLOps Engineer,Computer Vision Engineer,Automation Engineer
SEARCH_LOCATIONS=Remote / Worldwide,Pakistan,United Kingdom,United States,Canada,Germany,Netherlands,Italy,United Arab Emirates,Saudi Arabia

# JobSpy site identifiers verified in JobSpy 1.3.0. Google Jobs is unavailable.
JOBSPY_SITES=indeed,linkedin
ENABLED_SOURCES=remote_ok,we_work_remotely,hacker_news

MAX_RESULTS_PER_QUERY=30
JOB_MAX_AGE_HOURS=1
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1
BACKOFF_MAX_SECONDS=30
MAX_CONCURRENT_REQUESTS=4
LINKEDIN_MIN_INTERVAL_SECONDS=10
RANDOM_DELAY_MIN_SECONDS=0
RANDOM_DELAY_MAX_SECONDS=0
MAX_EXECUTION_SECONDS=1800
HN_MAX_COMMENTS=100
HN_STORY_SCAN_LIMIT=200

DATABASE_URL=sqlite:///jobs.db
LOG_LEVEL=INFO
OUTPUT_DIR=output
EXPORT_FORMATS=csv,json
ENABLE_CSV_EXPORT=true
ENABLE_JSON_EXPORT=true

# Optional: one authorized HTTP(S) proxy only. Rotation is intentionally disabled.
# PROXIES_LIST=https://proxy.example.invalid:8443
