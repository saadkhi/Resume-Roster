# Copy to .env.local and fill in. Never commit real values.

# ── Sessions (required to enable sign-in) ───────────────────────────
# Signs the httpOnly session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ── Supabase Auth (optional; enables sign-in) ───────────────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ── Database (optional; durable evaluation history) ─────────────────
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# PEM text of the provider CA certificate, to verify the DB server certificate
# DATABASE_SSL_CA=

# ── Operator access ─────────────────────────────────────────────────
# Email allowed to call /api/admin/* with a verified Supabase token
ADMIN_EMAIL=
# Alternative server-to-server key for /api/admin/* (X-Admin-Key header)
# Generate with: openssl rand -hex 32
ADMIN_OVERRIDE_KEY=

# ── Public contact address shown on legal pages (optional) ──────────
CONTACT_EMAIL=

NODE_ENV=development
PORT=3000
