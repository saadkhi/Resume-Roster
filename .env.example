# Copy to .env.local and fill in. Never commit real values.

# Signs the httpOnly session cookie (required for accounts in production).
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Postgres connection string (Neon or any Postgres). Enables accounts and
# durable history on serverless hosts. Use the pooled connection string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: PEM CA certificate to pin the database server certificate
# DATABASE_SSL_CA=

# Optional: secret for operator routes (X-Admin-Key header, min 16 chars).
# Generate with: openssl rand -hex 32
ADMIN_OVERRIDE_KEY=

# Optional: public contact address shown on the legal pages
CONTACT_EMAIL=

# Optional: AI-written application emails (https://openrouter.ai/keys).
# Without a key the "Apply by email" tool falls back to a template draft.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional extra job sources (enabled when set)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=us            # or a list: us,gb,in,ca,au (at,au,be,br,ca,ch,de,es,fr,gb,in,it,mx,nl,nz,pl,sg,us,za)
# Company boards (comma-separated slugs, optional)
# GREENHOUSE_BOARDS=stripe,airbnb,figma
# LEVER_BOARDS=spotify
# ASHBY_BOARDS=linear,notion
# JSEARCH_API_KEY=            # RapidAPI; LinkedIn/Indeed/Glassdoor via Google Jobs
# JSEARCH_COUNTRY=us
# SERPAPI_KEY=                 # Google Jobs via SerpApi
# USAJOBS_API_KEY=
# USAJOBS_EMAIL=
# REED_API_KEY=
# JOOBLE_API_KEY=
# FINDWORK_API_KEY=

NODE_ENV=development
PORT=3000
