# ============================================================
# Resume Rater - Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or .env to git.
# ============================================================

# --- Supabase Auth & API ---
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# --- Supabase PostgreSQL Direct Connection ---
SUPABASE_DB_HOST=db.<your-project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<your-db-password>
DATABASE_URL=postgresql://postgres:<your-db-password>@db.<your-project-ref>.supabase.co:5432/postgres

# --- Admin Configuration ---
# Email address of the platform administrator (checked server-side against verified Supabase JWT)
ADMIN_EMAIL=<your-admin-email>
# Secret key for the admin override endpoint (generate with: openssl rand -hex 32)
ADMIN_OVERRIDE_KEY=<generate-a-strong-random-secret>

# --- Application ---
NODE_ENV=development
PORT=3000
PLATFORM_MODE=free_unlimited
