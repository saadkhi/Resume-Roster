<%- include('partials/head', { pageTitle: 'Sign in' }) %>
<%- include('partials/header') %>

<main id="main-content" class="container" data-page="auth">
    <div class="card auth-card">
        <h1>Sign in to Resume Rater</h1>
        <p class="muted small" style="margin-top:0.4rem">An account is optional. Signing in saves your scores and keyword gaps so you can track progress. Your resume text is never stored.</p>

        <div class="alert alert-info" id="authAlert" role="alert" hidden></div>

        <div class="tabs-inline" role="group" aria-label="Sign in or create account">
            <button type="button" id="modeSignIn" aria-pressed="true" data-auth-control>Sign in</button>
            <button type="button" id="modeSignUp" aria-pressed="false" data-auth-control>Create account</button>
        </div>

        <div class="oauth-list">
            <button type="button" class="btn btn-secondary btn-block" data-provider="google" data-auth-control>Continue with Google</button>
            <button type="button" class="btn btn-secondary btn-block" data-provider="github" data-auth-control>Continue with GitHub</button>
            <button type="button" class="btn btn-secondary btn-block" data-provider="azure" data-auth-control>Continue with Microsoft</button>
        </div>

        <div class="divider-text">or use email</div>

        <form id="emailForm" novalidate>
            <div class="field" id="nameField" hidden>
                <label class="label" for="fullName">Name</label>
                <input class="input" id="fullName" type="text" autocomplete="name" maxlength="100" data-auth-control>
            </div>
            <div class="field">
                <label class="label" for="email">Email</label>
                <input class="input" id="email" type="email" autocomplete="email" required data-auth-control>
            </div>
            <div class="field">
                <label class="label" for="password">Password</label>
                <input class="input" id="password" type="password" autocomplete="current-password" required data-auth-control>
            </div>
            <button type="submit" class="btn btn-primary btn-block" id="btnSubmit" style="margin-top:1.25rem" data-auth-control>Sign in</button>
        </form>

        <p class="small muted" style="margin-top:1.25rem">
            By continuing you agree to the <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>.
        </p>
    </div>
</main>

<%- include('partials/footer') %>
<script src="<%= asset('/vendor/supabase.js') %>" defer></script>
<script src="<%= asset('/js/auth.js') %>" defer></script>
</body>
</html>
