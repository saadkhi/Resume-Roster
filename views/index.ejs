    <!-- Client-side Application Controller -->
    <script>
        (function() {
            // DOM Elements
            const dropzone = document.getElementById('dropzone');
            const fileInput = document.getElementById('resumeFileInput');
            const selectedFileCard = document.getElementById('selectedFileCard');
            const selectedFileName = document.getElementById('selectedFileName');
            const selectedFileSize = document.getElementById('selectedFileSize');
            const btnRemoveFile = document.getElementById('btnRemoveFile');
            const btnParseResume = document.getElementById('btnParseResume');
            const btnParseText = document.getElementById('btnParseText');
            const uploadStatusBadge = document.getElementById('uploadStatusBadge');
            const progressContainer = document.getElementById('progressContainer');
            const progressStepText = document.getElementById('progressStepText');
            const alertBox = document.getElementById('alertBox');
            const jdToggleHeader = document.getElementById('jdToggleHeader');
            const jdFieldsWrap = document.getElementById('jdFieldsWrap');
            const jdChevron = document.getElementById('jdChevron');
            const jobKeywordsSelect = document.getElementById('jobKeywordsSelect');
            const jobDescriptionTextarea = document.getElementById('jobDescriptionTextarea');

            // Result Metrics Elements
            const resCategory = document.getElementById('resCategory');
            const resFilename = document.getElementById('resFilename');
            const resSimilarityScore = document.getElementById('resSimilarityScore');
            const resMatchBadge = document.getElementById('resMatchBadge');
            const resTargetRoleKicker = document.getElementById('resTargetRoleKicker');
            const resPages = document.getElementById('resPages');
            const resWords = document.getElementById('resWords');
            const resChars = document.getElementById('resChars');

            // Section Boxes
            const secEducation = document.getElementById('sec-education');
            const secExperience = document.getElementById('sec-experience');
            const secSkills = document.getElementById('sec-skills');
            const secProjects = document.getElementById('sec-projects');
            const cleanedTextPre = document.getElementById('cleanedTextPre');
            const rawTextPre = document.getElementById('rawTextPre');

            // Live Matcher Elements
            const liveJdPreset = document.getElementById('liveJdPreset');
            const liveJdInput = document.getElementById('liveJdInput');
            const btnComputeLiveMatch = document.getElementById('btnComputeLiveMatch');
            const liveScoreNum = document.getElementById('liveScoreNum');
            const liveRatingText = document.getElementById('liveRatingText');
            const liveMatchDesc = document.getElementById('liveMatchDesc');
            const keywordAlignmentList = document.getElementById('keywordAlignmentList');

            // Modal & Billing Elements
            const upgradeModal = document.getElementById('upgradeModal');
            const modalCloseBtn = document.getElementById('modalCloseBtn');
            const modalTitle = document.getElementById('modalTitle');
            const modalDesc = document.getElementById('modalDesc');
            const planChoiceMonthly = document.getElementById('planChoiceMonthly');
            const planChoiceAnnual = document.getElementById('planChoiceAnnual');
            const btnModalCheckoutAction = document.getElementById('btnModalCheckoutAction');
            const btnModalCheckoutText = document.getElementById('btnModalCheckoutText');
            const btnModalSimulateUpgrade = document.getElementById('btnModalSimulateUpgrade');
            const btnNavUpgradeAction = document.getElementById('btnNavUpgradeAction');
            const quotaNavDisplay = document.getElementById('quotaNavDisplay');
            const btnDevTogglePro = document.getElementById('btnDevTogglePro');
            const btnDevSimulateLimit = document.getElementById('btnDevSimulateLimit');
            const btnDevResetQuota = document.getElementById('btnDevResetQuota');

            // Job Listings Elements
            const jobsSearchInput = document.getElementById('jobsSearchInput');
            const jobsCategoryFilter = document.getElementById('jobsCategoryFilter');
            const jobsSortFilter = document.getElementById('jobsSortFilter');
            const jobsRemoteToggle = document.getElementById('jobsRemoteToggle');
            const btnRefreshJobs = document.getElementById('btnRefreshJobs');
            const jobsCardsContainer = document.getElementById('jobsCardsContainer');
            const jobsStatusBanner = document.getElementById('jobsStatusBanner');
            const jobsStatusText = document.getElementById('jobsStatusText');
            const jobsCountBadge = document.getElementById('jobsCountBadge');
            const jobsTabCounter = document.getElementById('jobsTabCounter');

            // Pagination & Display State for All Database Jobs
            const jobsPaginationBar = document.getElementById('jobsPaginationBar');
            const jobsPageInfo = document.getElementById('jobsPageInfo');
            const jobsPageCurrent = document.getElementById('jobsPageCurrent');
            const btnJobsPrevPage = document.getElementById('btnJobsPrevPage');
            const btnJobsNextPage = document.getElementById('btnJobsNextPage');
            const btnJobsToggleShowAll = document.getElementById('btnJobsToggleShowAll');
            let jobsDisplayMode = 'all'; // Default: 'all' to show all retrieved database jobs
            let jobsCurrentPage = 1;
            const JOBS_PAGE_SIZE = 12;

            let currentFile = null;
            let currentParsedData = null;
            let selectedPlan = 'monthly';

            function escapeHtml(str) {
                if (str === null || str === undefined) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function formatBytes(bytes) {
                if (!bytes || bytes === 0) return '0 KB';
                const k = 1024;
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                const sizes = ['Bytes', 'KB', 'MB', 'GB'];
                return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
            }

            function showAlert(msg, isError = true) {
                if (!alertBox) return;
                alertBox.textContent = msg;
                alertBox.className = 'alert-box ' + (isError ? 'error' : 'success');
                alertBox.style.display = 'block';
            }

            function clearAlert() {
                if (!alertBox) return;
                alertBox.textContent = '';
                alertBox.style.display = 'none';
            }

            // Accordion Toggle
            if (jdToggleHeader && jdFieldsWrap) {
                jdToggleHeader.addEventListener('click', () => {
                    const isClosed = jdFieldsWrap.style.display === 'none';
                    jdFieldsWrap.style.display = isClosed ? 'flex' : 'none';
                    if (jdChevron) jdChevron.style.transform = isClosed ? 'rotate(180deg)' : 'rotate(0deg)';
                });
            }

            // Handle File Selection
            function handleFile(file) {
                clearAlert();
                if (!file) return;

                if (!file.name.toLowerCase().endsWith('.pdf') && file.type !== 'application/pdf') {
                    showAlert('Only PDF files (.pdf) are supported. Please select a valid resume document.');
                    resetFileInput();
                    return;
                }

                if (file.size > 15 * 1024 * 1024) {
                    showAlert('File size exceeds the 15MB limit. Please upload a smaller document.');
                    resetFileInput();
                    return;
                }

                currentFile = file;
                if (selectedFileName) selectedFileName.textContent = file.name;
                if (selectedFileSize) selectedFileSize.textContent = formatBytes(file.size);
                if (selectedFileCard) selectedFileCard.style.display = 'flex';
                if (dropzone) dropzone.style.display = 'none';
                if (btnParseResume) btnParseResume.disabled = false;
                if (uploadStatusBadge) uploadStatusBadge.textContent = 'Ready to Parse';
            }

            function resetFileInput() {
                currentFile = null;
                if (fileInput) fileInput.value = '';
                if (selectedFileCard) selectedFileCard.style.display = 'none';
                if (dropzone) dropzone.style.display = 'block';
                if (uploadStatusBadge) uploadStatusBadge.textContent = 'Ready';
            }

            if (btnRemoveFile) btnRemoveFile.addEventListener('click', resetFileInput);

            if (fileInput) {
                fileInput.addEventListener('change', (e) => {
                    if (e.target.files && e.target.files[0]) {
                        handleFile(e.target.files[0]);
                    }
                });
            }

            if (dropzone) {
                ['dragenter', 'dragover'].forEach(eventName => {
                    dropzone.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.add('drag-over');
                    }, false);
                });

                ['dragleave', 'drop'].forEach(eventName => {
                    dropzone.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        dropzone.classList.remove('drag-over');
                    }, false);
                });

                dropzone.addEventListener('drop', (e) => {
                    const dt = e.dataTransfer;
                    if (dt && dt.files && dt.files[0]) {
                        handleFile(dt.files[0]);
                    }
                });
            }

            // Upload and Parse File via API
            async function uploadAndParseResume() {
                if (!currentFile) return;

                clearAlert();
                setLoadingState(true, 'Uploading PDF & extracting text layers...');

                try {
                    const formData = new FormData();
                    formData.append('resume', currentFile);

                    const jdText = jobDescriptionTextarea ? jobDescriptionTextarea.value.trim() : '';
                    const jdKeywords = jobKeywordsSelect ? jobKeywordsSelect.value : '';
                    if (jdText) formData.append('job_description_text', jdText);
                    if (jdKeywords) formData.append('job_keywords', jdKeywords);

                    const res = await fetch('/api/parse-resume', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        throw new Error(data.error || 'Failed to parse resume document.');
                    }

                    if (data.billing) updateQuotaUI(data.billing);
                    renderParsedResults(data);
                } catch (err) {
                    console.error('Parse error:', err);
                    showAlert(err.message);
                } finally {
                    setLoadingState(false);
                }
            }

            if (btnParseResume) btnParseResume.addEventListener('click', uploadAndParseResume);

            // Quick Samples Delegation
            document.querySelectorAll('.sample-chip').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.sample-chip').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');

                    const sampleName = btn.getAttribute('data-sample');
                    const sampleRole = btn.getAttribute('data-role');
                    if (sampleRole && jobKeywordsSelect) {
                        jobKeywordsSelect.value = sampleRole;
                    }
                    parseSampleFile(sampleName, sampleRole);
                });
            });

            async function parseSampleFile(sampleName, roleKeywords, isSamplePreview = false) {
                clearAlert();
                setLoadingState(true, `Loading sample (${escapeHtml(sampleName)})...`);

                try {
                    const jdText = jobDescriptionTextarea ? jobDescriptionTextarea.value.trim() : '';
                    const jdKeywords = roleKeywords || (jobKeywordsSelect ? jobKeywordsSelect.value : '');

                    const res = await fetch('/api/parse-sample', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            sampleName,
                            job_description_text: jdText,
                            job_keywords: jdKeywords,
                            isSamplePreview
                        })
                    });

                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        throw new Error(data.error || 'Failed to parse sample file.');
                    }

                    if (data.billing) updateQuotaUI(data.billing);
                    renderParsedResults(data);
                } catch (err) {
                    console.error('Sample parse error:', err);
                    showAlert(err.message);
                } finally {
                    setLoadingState(false);
                }
            }

            function setLoadingState(loading, text = 'Processing...') {
                if (loading) {
                    if (btnParseResume) btnParseResume.disabled = true;
                    if (btnParseText) btnParseText.textContent = 'Parsing...';
                    if (progressContainer) progressContainer.style.display = 'block';
                    if (progressStepText) progressStepText.textContent = text;
                    if (uploadStatusBadge) uploadStatusBadge.textContent = 'Analyzing';
                } else {
                    if (btnParseResume) btnParseResume.disabled = !currentFile;
                    if (btnParseText) btnParseText.textContent = 'Evaluate & Parse Resume';
                    if (progressContainer) progressContainer.style.display = 'none';
                    if (uploadStatusBadge) uploadStatusBadge.textContent = 'Ready';
                }
            }

            // Render Parsed Data into Dashboard Viewport
            function renderParsedResults(data) {
                currentParsedData = data;

                // 1. Metric Scorecards
                if (resCategory) resCategory.textContent = data.category || 'Career Role';
                if (resFilename) resFilename.textContent = data.filename || 'Candidate Resume';
                if (resPages) resPages.textContent = `${data.stats?.pageCount || data.pages || 1} page`;
                if (resWords) resWords.textContent = (data.stats?.wordCount || 480).toLocaleString();
                if (resChars) resChars.textContent = (data.stats?.characterCount || 3400).toLocaleString();

                const score = data.match?.similarityScore !== undefined ? data.match.similarityScore : 0.85;
                const rating = data.match?.matchRating || 'High Match';

                if (resSimilarityScore) resSimilarityScore.textContent = Number(score).toFixed(2);
                if (resMatchBadge) {
                    resMatchBadge.textContent = rating;
                    resMatchBadge.className = 'status-badge ' + (rating.includes('High') ? 'high' : rating.includes('Medium') ? 'medium' : 'low');
                }
                if (resTargetRoleKicker) {
                    resTargetRoleKicker.textContent = `vs. ${data.match?.targetJob || data.category || 'Benchmark'}`;
                }

                // 2. Sections
                const sections = data.sections || {};
                renderSectionBox(secEducation, sections.Education, 'Education');
                renderSectionBox(secExperience, sections.Experience, 'Work Experience');
                renderSectionBox(secSkills, sections.Skills, 'Technical Skills');
                renderSectionBox(secProjects, sections.Projects, 'Projects & Systems');

                // 3. Text Previews
                if (cleanedTextPre) cleanedTextPre.textContent = data.cleanedText || 'No cleaned text available.';
                if (rawTextPre) rawTextPre.textContent = data.rawText || 'No raw text available.';

                // 4. Live Matcher Sync
                if (liveScoreNum) liveScoreNum.textContent = Number(score).toFixed(2);
                if (liveRatingText) {
                    liveRatingText.textContent = rating;
                    liveRatingText.style.color = rating.includes('High') ? '#16a34a' : rating.includes('Medium') ? '#d97706' : '#dc2626';
                }
                if (liveMatchDesc) {
                    liveMatchDesc.textContent = `${Math.round(score * 100)}% vector alignment against ${data.match?.targetJob || data.category || 'Job'} requirements.`;
                }

                if (data.match?.keywordAlignment && keywordAlignmentList) {
                    keywordAlignmentList.innerHTML = data.match.keywordAlignment.slice(0, 8).map(kw => `
                        <div class="keyword-item ${kw.matched ? 'matched' : 'missing'}">
                            <span>${escapeHtml(kw.keyword)}</span>
                            <span style="font-family: monospace; font-weight: bold; color: ${kw.matched ? '#16a34a' : '#dc2626'};">${kw.matched ? 'Matched' : 'Missing'}</span>
                        </div>
                    `).join('');
                }

                // 5. Mount Recharts Component
                if (window.renderMatchVisualizer) {
                    window.renderMatchVisualizer('recharts-match-container', data);
                }

                // 6. Sync and rank live Job Listings against this candidate's resume
                if (typeof fetchAndRenderJobs === 'function') {
                    fetchAndRenderJobs();
                }
            }

            function renderSectionBox(el, content, fallbackName) {
                if (!el) return;
                if (!content || content.toLowerCase().includes('not found')) {
                    el.textContent = `${fallbackName} section not explicitly detected in this document.`;
                    el.classList.add('empty');
                } else {
                    el.textContent = content;
                    el.classList.remove('empty');
                }
            }

            // Tab Navigation Event Delegation
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const targetId = btn.getAttribute('data-tab');

                    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));

                    btn.classList.add('active');
                    const pane = document.getElementById(targetId);
                    if (pane) pane.classList.add('active');

                    // Resize Recharts SVG canvas whenever radar tab is activated
                    window.dispatchEvent(new Event('resize'));
                    if (targetId === 'tab-recharts' && currentParsedData && window.renderMatchVisualizer) {
                        window.renderMatchVisualizer('recharts-match-container', currentParsedData);
                    }
                    if (targetId === 'tab-jobs' && (!cachedJobs || cachedJobs.length === 0) && typeof fetchAndRenderJobs === 'function') {
                        fetchAndRenderJobs();
                    }
                });
            });

            // Top Header Nav Tab Links
            document.querySelectorAll('.nav-tab-link').forEach(link => {
                link.addEventListener('click', (e) => {
                    e.preventDefault();
                    const tabTarget = link.getAttribute('data-tab-target');
                    const matchingTabBtn = document.querySelector(`.tab-btn[data-tab="${tabTarget}"]`);
                    if (matchingTabBtn) {
                        matchingTabBtn.click();
                        matchingTabBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
            });

            // 1-Click Copy Buttons
            document.querySelectorAll('.btn-copy-section').forEach(btn => {
                btn.addEventListener('click', () => {
                    const targetId = btn.getAttribute('data-target');
                    let text = '';
                    if (targetId) {
                        const targetEl = document.getElementById(targetId);
                        text = targetEl ? targetEl.textContent : '';
                    } else if (btn.id === 'btnCopyCleaned') {
                        text = cleanedTextPre ? cleanedTextPre.textContent : '';
                    } else if (btn.id === 'btnCopyRaw') {
                        text = rawTextPre ? rawTextPre.textContent : '';
                    }

                    if (text) {
                        navigator.clipboard.writeText(text).then(() => {
                            const original = btn.textContent;
                            btn.textContent = 'Copied!';
                            setTimeout(() => { btn.textContent = original; }, 1500);
                        }).catch(err => console.error('Copy failed:', err));
                    }
                });
            });

            // Live Match Preset Change
            if (liveJdPreset) {
                liveJdPreset.addEventListener('change', () => {
                    if (liveJdPreset.value && liveJdInput) {
                        liveJdInput.value = liveJdPreset.value;
                        // Trigger immediate live re-evaluation
                        if (btnComputeLiveMatch) btnComputeLiveMatch.click();
                    }
                });
            }

            if (btnComputeLiveMatch) {
                btnComputeLiveMatch.addEventListener('click', async () => {
                    if (!currentParsedData || !currentParsedData.rawText) {
                        showAlert('Please parse a resume PDF first.');
                        return;
                    }

                    const jd = liveJdInput ? liveJdInput.value.trim() : '';
                    if (!jd) {
                        showAlert('Please enter job description text or select a role preset.');
                        return;
                    }

                    btnComputeLiveMatch.disabled = true;
                    btnComputeLiveMatch.textContent = 'Evaluating...';

                    try {
                        const res = await fetch('/api/evaluate-match', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                resumeText: currentParsedData.rawText,
                                jobDescriptionText: jd,
                                resumeSections: currentParsedData.sections
                            })
                        });

                        const data = await res.json();
                        if (!res.ok || !data.success) {
                            throw new Error(data.error || 'Evaluation failed.');
                        }

                        if (liveScoreNum) liveScoreNum.textContent = Number(data.similarityScore).toFixed(2);
                        if (liveRatingText) {
                            liveRatingText.textContent = data.matchRating;
                            liveRatingText.style.color = data.matchRating.includes('High') ? '#16a34a' : data.matchRating.includes('Medium') ? '#d97706' : '#dc2626';
                        }
                        if (liveMatchDesc) {
                            liveMatchDesc.textContent = `${data.percentage}% vector alignment against current requirements.`;
                        }

                        if (resSimilarityScore) resSimilarityScore.textContent = Number(data.similarityScore).toFixed(2);
                        if (resMatchBadge) {
                            resMatchBadge.textContent = data.matchRating;
                            resMatchBadge.className = 'status-badge ' + (data.matchRating.includes('High') ? 'high' : data.matchRating.includes('Medium') ? 'medium' : 'low');
                        }

                        if (data.keywordAlignment && keywordAlignmentList) {
                            keywordAlignmentList.innerHTML = data.keywordAlignment.slice(0, 8).map(kw => `
                                <div class="keyword-item ${kw.matched ? 'matched' : 'missing'}">
                                    <span>${escapeHtml(kw.keyword)}</span>
                                    <span style="font-family: monospace; font-weight: bold; color: ${kw.matched ? '#16a34a' : '#dc2626'};">${kw.matched ? 'Matched' : 'Missing'}</span>
                                </div>
                            `).join('');
                        }

                        // Update global Recharts data
                        currentParsedData.match = {
                            ...data,
                            targetJob: jd.length > 40 ? jd.substring(0, 40) + '...' : jd
                        };

                        if (window.renderMatchVisualizer) {
                            window.renderMatchVisualizer('recharts-match-container', currentParsedData);
                        }
                    } catch (err) {
                        showAlert(err.message);
                    } finally {
                        btnComputeLiveMatch.disabled = false;
                        btnComputeLiveMatch.textContent = 'Evaluate Match Score';
                    }
                });
            }

            // ==========================================
            // Job Listings (JobDataLake API Integration)
            // ==========================================
            let jobsDebounceTimer = null;

            function getJobSalaryValue(salaryStr) {
                if (!salaryStr) return 0;
                const matches = salaryStr.match(/\$([0-9,]+)/g);
                if (!matches || matches.length === 0) return 0;
                const lastNum = parseInt(matches[matches.length - 1].replace(/[$,]/g, ''), 10);
                return isNaN(lastNum) ? 0 : lastNum;
            }

            async function fetchAndRenderJobs() {
                if (!jobsCardsContainer) return;

                const query = jobsSearchInput ? jobsSearchInput.value.trim() : '';
                const category = jobsCategoryFilter ? jobsCategoryFilter.value : '';
                const remote = jobsRemoteToggle ? jobsRemoteToggle.checked : false;
                const resumeText = (currentParsedData && currentParsedData.rawText) ? currentParsedData.rawText : '';

                if (jobsStatusText) {
                    jobsStatusText.textContent = resumeText 
                        ? 'Scoring JobDataLake opportunities against parsed resume...' 
                        : 'Loading live tech roles from JobDataLake API...';
                }

                try {
                    const res = await fetch('/api/jobs', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            query,
                            category,
                            remote,
                            resumeText
                        })
                    });

                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        throw new Error(data.error || 'Failed to fetch jobs.');
                    }

                    cachedJobs = data.jobs || [];
                    renderJobsList(cachedJobs, data.hasResumeMatch);
                } catch (err) {
                    console.error('Job fetch error:', err);
                    if (jobsCardsContainer) {
                        jobsCardsContainer.innerHTML = `
                            <div style="text-align: center; padding: 2.5rem; color: #dc2626; font-size: 0.8125rem; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px;">
                                <p style="font-weight: 600; margin-bottom: 0.35rem;">Unable to load JobDataLake listings</p>
                                <p style="font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 0.75rem;">${err.message}</p>
                                <button type="button" class="btn-job-action secondary" onclick="window.fetchAndRenderJobs()" style="margin: 0 auto;">Retry</button>
                            </div>
                        `;
                    }
                }
            }

            function renderJobsList(jobs, hasResumeMatch = false) {
                if (!jobsCardsContainer) return;

                const sortMode = jobsSortFilter ? jobsSortFilter.value : 'match';
                let sorted = [...jobs];

                if (sortMode === 'salary') {
                    sorted.sort((a, b) => getJobSalaryValue(b.salary) - getJobSalaryValue(a.salary));
                } else if (sortMode === 'recent') {
                    // default order from API
                } else {
                    if (hasResumeMatch || (sorted.length > 0 && sorted[0].similarityScore !== undefined)) {
                        sorted.sort((a, b) => (b.similarityScore || 0) - (a.similarityScore || 0));
                    }
                }

                if (jobsCountBadge) jobsCountBadge.textContent = `${sorted.length} ${sorted.length === 1 ? 'Position' : 'Positions'}`;
                if (jobsTabCounter) jobsTabCounter.textContent = `${sorted.length}`;

                if (jobsStatusBanner && jobsStatusText) {
                    if (currentParsedData && currentParsedData.rawText) {
                        jobsStatusText.innerHTML = `<strong>ATS Match Active:</strong> Evaluated all ${sorted.length} positions against <em>${escapeHtml(currentParsedData.filename || 'Candidate Resume')}</em> (${escapeHtml(currentParsedData.category || 'Career Role')}).`;
                    } else {
                        jobsStatusText.innerHTML = `Displaying all ${sorted.length} tech positions from database. <em>Upload or select a resume on the left</em> to activate live TF-IDF vector match scoring.`;
                    }
                }

                if (sorted.length === 0) {
                    if (jobsPaginationBar) jobsPaginationBar.style.display = 'none';
                    jobsCardsContainer.innerHTML = `
                        <div style="text-align: center; padding: 3rem 1.5rem; background: #fafafa; border: 1px solid var(--border-hairline); border-radius: 8px;">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--text-muted); margin: 0 auto 0.75rem;">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                            <h4 style="font-size: 0.9375rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.35rem;">No matching job openings found</h4>
                            <p style="font-size: 0.8125rem; color: var(--text-secondary); margin-bottom: 1rem;">Try clearing your search query or broadening category filters.</p>
                            <button type="button" class="btn-job-action secondary" id="btnResetJobFilters" style="margin: 0 auto;">Reset Filters</button>
                        </div>
                    `;
                    const resetBtn = document.getElementById('btnResetJobFilters');
                    if (resetBtn) {
                        resetBtn.addEventListener('click', () => {
                            if (jobsSearchInput) jobsSearchInput.value = '';
                            if (jobsCategoryFilter) jobsCategoryFilter.value = '';
                            if (jobsRemoteToggle) jobsRemoteToggle.checked = false;
                            jobsCurrentPage = 1;
                            fetchAndRenderJobs();
                        });
                    }
                    return;
                }

                // Manage display mode & pagination slices
                let displayJobs = sorted;
                if (jobsPaginationBar) {
                    jobsPaginationBar.style.display = 'flex';
                    if (jobsDisplayMode === 'all') {
                        displayJobs = sorted;
                        if (jobsPageInfo) jobsPageInfo.textContent = `Displaying all ${sorted.length} positions retrieved from database`;
                        if (jobsPageCurrent) jobsPageCurrent.textContent = `All ${sorted.length} visible`;
                        if (btnJobsPrevPage) btnJobsPrevPage.style.display = 'none';
                        if (btnJobsNextPage) btnJobsNextPage.style.display = 'none';
                        if (btnJobsToggleShowAll) {
                            btnJobsToggleShowAll.textContent = sorted.length > JOBS_PAGE_SIZE ? `Paginate (${JOBS_PAGE_SIZE}/page)` : `Showing All (${sorted.length})`;
                            btnJobsToggleShowAll.classList.add('active-toggle');
                        }
                    } else {
                        const totalPages = Math.ceil(sorted.length / JOBS_PAGE_SIZE) || 1;
                        if (jobsCurrentPage > totalPages) jobsCurrentPage = 1;
                        const startIdx = (jobsCurrentPage - 1) * JOBS_PAGE_SIZE;
                        displayJobs = sorted.slice(startIdx, startIdx + JOBS_PAGE_SIZE);

                        if (jobsPageInfo) jobsPageInfo.textContent = `Showing positions ${startIdx + 1}–${Math.min(startIdx + JOBS_PAGE_SIZE, sorted.length)} of ${sorted.length} in database`;
                        if (jobsPageCurrent) {
                            jobsPageCurrent.textContent = `Page ${jobsCurrentPage} of ${totalPages}`;
                            jobsPageCurrent.style.display = 'inline-block';
                        }
                        if (btnJobsPrevPage) {
                            btnJobsPrevPage.style.display = 'inline-flex';
                            btnJobsPrevPage.disabled = jobsCurrentPage <= 1;
                        }
                        if (btnJobsNextPage) {
                            btnJobsNextPage.style.display = 'inline-flex';
                            btnJobsNextPage.disabled = jobsCurrentPage >= totalPages;
                        }
                        if (btnJobsToggleShowAll) {
                            btnJobsToggleShowAll.textContent = `Display All (${sorted.length})`;
                            btnJobsToggleShowAll.classList.remove('active-toggle');
                        }
                    }
                }

                const candidateFullText = (currentParsedData ? `${currentParsedData.rawText || ''} ${currentParsedData.cleanedText || ''} ${JSON.stringify(currentParsedData.sections || {})}` : '').toLowerCase();

                jobsCardsContainer.innerHTML = displayJobs.map(job => {
                    const matchScore = job.matchPercentage !== undefined ? job.matchPercentage : null;
                    const rating = job.matchRating || (matchScore >= 75 ? 'High Match' : matchScore >= 45 ? 'Medium Match' : 'Low Match');
                    const pillClass = matchScore !== null ? (rating.includes('High') ? 'high' : rating.includes('Medium') ? 'medium' : 'low') : 'neutral';

                    const skillsHtml = (job.skills || []).map(skill => {
                        const cleanSkill = skill.toLowerCase().trim();
                        const isSkillMatched = candidateFullText && cleanSkill.length > 1 && (
                            candidateFullText.includes(cleanSkill) || 
                            candidateFullText.includes(cleanSkill.replace(/[^a-z0-9]/g, ''))
                        );
                        return `
                            <span class="job-skill-chip ${isSkillMatched ? 'matched' : ''}" title="${isSkillMatched ? 'Matched in candidate profile' : 'Required skill'}">
                                ${isSkillMatched ? '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>' : ''}
                                ${escapeHtml(skill)}
                            </span>
                        `;
                    }).join('');

                    return `
                        <div class="job-card" data-job-id="${escapeHtml(job.id)}">
                            <div class="job-card-header">
                                <div class="job-card-title-group">
                                    <div class="job-company-avatar">
                                        ${escapeHtml(job.companyInitial || (job.company ? job.company.charAt(0) : 'J'))}
                                    </div>
                                    <div>
                                        <h3 class="job-title-text">${escapeHtml(job.title)}</h3>
                                        <div class="job-company-meta">
                                            <span style="font-weight: 600; color: var(--text-primary);">${escapeHtml(job.company)}</span>
                                            <span>·</span>
                                            <span>
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: inline; vertical-align: -1px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                                ${escapeHtml(job.location)}
                                            </span>
                                            <span>·</span>
                                            <span class="job-tag remote">${escapeHtml(job.remoteText || (job.remote ? 'Remote' : 'On-Site'))}</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="job-match-badge-box">
                                    ${matchScore !== null ? `
                                        <span class="job-match-pill ${pillClass}">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            ${matchScore}% Match · ${escapeHtml(rating)}
                                        </span>
                                        <div class="job-meter-bar">
                                            <div class="job-meter-fill" style="width: ${matchScore}%; background: ${pillClass === 'high' ? '#16a34a' : pillClass === 'medium' ? '#d97706' : '#dc2626'};"></div>
                                        </div>
                                    ` : `
                                        <span class="job-match-pill neutral" title="Upload a resume on the left to see ATS vector match">
                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                                            Match on Parse
                                        </span>
                                    `}
                                </div>
                            </div>

                            <div class="job-tags-row">
                                <span class="job-tag">${escapeHtml(job.category)}</span>
                                <span class="job-tag">${escapeHtml(job.employmentType)}</span>
                                <span class="job-tag">${escapeHtml(job.experienceLevel)}</span>
                                <span class="job-tag salary">${escapeHtml(job.salary)}</span>
                                <span class="job-tag" style="color: var(--text-muted);">${escapeHtml(job.postedAt)}</span>
                                <span class="job-tag" style="background: #ffffff; border-color: var(--border-hairline); color: var(--accent-primary);">JobDataLake API</span>
                            </div>

                            <p class="job-description-text">${escapeHtml(job.description)}</p>

                            <div>
                                <div style="font-size: 0.6875rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.35rem;">
                                    Key Competencies & Keywords:
                                </div>
                                <div class="job-skills-chips">
                                    ${skillsHtml}
                                </div>
                            </div>

                            <div class="job-card-actions">
                                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                    <button type="button" class="btn-job-action primary btn-evaluate-role" data-job-id="${escapeHtml(job.id)}">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                        Evaluate in Role Matcher
                                    </button>
                                    <button type="button" class="btn-job-action secondary btn-copy-job-reqs" data-job-id="${escapeHtml(job.id)}">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                                        Copy Requirements
                                    </button>
                                </div>

                                <a href="${escapeHtml(job.applyUrl && /^https?:\/\//i.test(job.applyUrl) ? job.applyUrl : '#')}" target="_blank" rel="noopener noreferrer" class="btn-job-action secondary" style="color: var(--accent-primary);">
                                    <span>Apply on Company Site</span>
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                </a>
                            </div>
                        </div>
                    `;
                }).join('');

                // Action Event Listeners
                jobsCardsContainer.querySelectorAll('.btn-evaluate-role').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const jobId = btn.getAttribute('data-job-id');
                        const targetJob = cachedJobs.find(j => j.id === jobId);
                        if (!targetJob) return;

                        const matcherTabBtn = document.querySelector('.tab-btn[data-tab="tab-matcher"]');
                        if (matcherTabBtn) matcherTabBtn.click();

                        if (liveJdPreset) liveJdPreset.value = '';
                        if (liveJdInput) {
                            liveJdInput.value = `${targetJob.title} (${targetJob.company})\n\nRequired Skills:\n${targetJob.skills.join(', ')}\n\nJob Description:\n${targetJob.description}`;
                        }

                        if (currentParsedData && currentParsedData.rawText && btnComputeLiveMatch) {
                            btnComputeLiveMatch.click();
                        } else {
                            showAlert(`Loaded "${targetJob.title}" into Role Matcher. Please upload a resume on the left to evaluate!`, false);
                        }

                        const resultsPanel = document.getElementById('resultsPanel');
                        if (resultsPanel) resultsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    });
                });

                jobsCardsContainer.querySelectorAll('.btn-copy-job-reqs').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const jobId = btn.getAttribute('data-job-id');
                        const targetJob = cachedJobs.find(j => j.id === jobId);
                        if (!targetJob) return;

                        const textToCopy = `${targetJob.title} - ${targetJob.company}\nLocation: ${targetJob.location} (${targetJob.remoteText})\nSalary: ${targetJob.salary}\nSkills: ${targetJob.skills.join(', ')}\n\n${targetJob.description}\n\nApply URL: ${targetJob.applyUrl}`;

                        navigator.clipboard.writeText(textToCopy).then(() => {
                            const origHtml = btn.innerHTML;
                            btn.innerHTML = `<span style="color: #16a34a; font-weight: bold;">Copied!</span>`;
                            setTimeout(() => { btn.innerHTML = origHtml; }, 1800);
                        });
                    });
                });
            }

            window.fetchAndRenderJobs = fetchAndRenderJobs;

            if (btnJobsToggleShowAll) {
                btnJobsToggleShowAll.addEventListener('click', () => {
                    jobsDisplayMode = jobsDisplayMode === 'all' ? 'paged' : 'all';
                    renderJobsList(cachedJobs, !!(currentParsedData && currentParsedData.rawText));
                });
            }

            if (btnJobsPrevPage) {
                btnJobsPrevPage.addEventListener('click', () => {
                    if (jobsCurrentPage > 1) {
                        jobsCurrentPage--;
                        renderJobsList(cachedJobs, !!(currentParsedData && currentParsedData.rawText));
                        const tabJobs = document.getElementById('tab-jobs');
                        if (tabJobs) tabJobs.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            }

            if (btnJobsNextPage) {
                btnJobsNextPage.addEventListener('click', () => {
                    const totalPages = Math.ceil(cachedJobs.length / JOBS_PAGE_SIZE) || 1;
                    if (jobsCurrentPage < totalPages) {
                        jobsCurrentPage++;
                        renderJobsList(cachedJobs, !!(currentParsedData && currentParsedData.rawText));
                        const tabJobs = document.getElementById('tab-jobs');
                        if (tabJobs) tabJobs.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            }

            if (jobsSearchInput) {
                jobsSearchInput.addEventListener('input', () => {
                    clearTimeout(jobsDebounceTimer);
                    jobsCurrentPage = 1;
                    jobsDebounceTimer = setTimeout(fetchAndRenderJobs, 250);
                });
            }

            if (jobsCategoryFilter) {
                jobsCategoryFilter.addEventListener('change', () => {
                    jobsCurrentPage = 1;
                    fetchAndRenderJobs();
                });
            }

            if (jobsSortFilter) {
                jobsSortFilter.addEventListener('change', () => {
                    renderJobsList(cachedJobs, !!(currentParsedData && currentParsedData.rawText));
                });
            }

            if (jobsRemoteToggle) {
                jobsRemoteToggle.addEventListener('change', () => {
                    jobsCurrentPage = 1;
                    fetchAndRenderJobs();
                });
            }

            if (btnRefreshJobs) {
                btnRefreshJobs.addEventListener('click', () => {
                    jobsCurrentPage = 1;
                    fetchAndRenderJobs();
                });
            }

            // ==========================================
            // 100% Free Platform & Supabase Integration
            // ==========================================
            function updateQuotaUI(billing) {
                if (quotaNavDisplay) {
                    quotaNavDisplay.innerHTML = `
                        <span class="quota-badge-pro" style="background: rgba(16, 185, 129, 0.12); color: #059669; border: 1px solid rgba(16, 185, 129, 0.3);">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            100% Free · Unlimited Scans
                        </span>
                    `;
                }
            }

            function handleUpgradeRequired(data) {
                // Free platform: All scans are unlimited. No paywall ever triggered.
                updateQuotaUI({ isPro: true, scansRemaining: 'unlimited' });
            }

            // Diagnostic & Dev Test Handlers
            const btnDevTestSupabase = document.getElementById('btnDevTestSupabase');
            if (btnDevTestSupabase) {
                btnDevTestSupabase.addEventListener('click', async () => {
                    try {
                        btnDevTestSupabase.textContent = 'Testing Supabase...';
                        const res = await fetch('/api/supabase/status');
                        const data = await res.json();
                        if (data.supabase && data.supabase.connected) {
                            showAlert(`✅ Supabase PostgreSQL connected successfully to ${data.connectionDetails.host}!`, false);
                        } else {
                            showAlert(`ℹ️ Supabase database: ${data.connectionDetails?.host} (Database parameters verified. Password can be set in SUPABASE_DB_PASSWORD)`, false);
                        }
                    } catch (err) {
                        showAlert('Supabase test error: ' + err.message, true);
                    } finally {
                        btnDevTestSupabase.textContent = 'Test Supabase Connection';
                    }
                });
            }

            const btnDevSampleParse = document.getElementById('btnDevSampleParse');
            if (btnDevSampleParse) {
                btnDevSampleParse.addEventListener('click', () => {
                    parseSampleFile('Saads_CV_Resume.pdf', 'Senior Full Stack Engineer, Node.js, PostgreSQL, React, TypeScript');
                });
            }

            // Header Sign Out Handler
            const btnHeaderSignOut = document.getElementById('btnHeaderSignOut');
            if (btnHeaderSignOut) {
                btnHeaderSignOut.addEventListener('click', async () => {
                    try {
                        await fetch('/api/auth/signout', { method: 'POST' });
                        window.location.reload();
                    } catch (err) {
                        window.location.reload();
                    }
                });
            }

            // Sync Free Unlimited Status
            fetch('/api/subscription-status')
                .then(r => r.json())
                .then(d => { updateQuotaUI(d); })
                .catch(() => { updateQuotaUI({ isPro: true }); });

            // ==========================================
            // State Initialization on Page Load
            // ==========================================
            // Automatically initialize dashboard with Saad Ali's sample resume
            // and Data Scientist / Machine Learning benchmark fit on load (preview mode, quota preserved)!
            window.addEventListener('DOMContentLoaded', () => {
                fetchAndRenderJobs();
                parseSampleFile('Saads_CV_Resume.pdf', 'Data Scientist, Machine Learning, Python, SQL, Statistics, Modeling', true);
            });
        })();
    </script>
</body>
</html>
