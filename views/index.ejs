<%- include('partials/head', { pageTitle: null }) %>
<%- include('partials/header') %>

<main id="main-content" class="container" data-page="home">
    <div id="srAnnouncer" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>

    <section class="hero">
        <p class="hero-greet">Hi, <%= locals.currentUser ? String(currentUser.name || currentUser.email).split(' ')[0] : 'there' %> 👋</p>
        <h1>Land the job you <em>actually want.</em></h1>
        <p class="lead">Check your resume against any job in seconds, spot the keywords you are missing, then browse fresh openings from 20+ job boards, ranked by how well you match.</p>
        <ul class="hero-points">
            <li>Free, no account needed</li>
            <li>PDF up to 4 MB</li>
            <li>Your resume text is not saved</li>
        </ul>
    </section>

    <div class="workspace">
        <!-- ── Inputs ─────────────────────────────────────────────── -->
        <div class="input-col">
            <form id="analyzeForm" class="card" novalidate>
                <div class="step">
                    <h2 class="step-title"><span class="step-num" aria-hidden="true">1</span>Add your resume</h2>

                    <div class="dropzone" id="dropzone">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <strong>Drop your PDF here</strong>
                        <span class="small muted">or</span>
                        <button type="button" class="btn btn-secondary btn-sm" id="btnBrowse" style="margin-top:0.4rem">Choose a PDF</button>
                        <input type="file" id="fileInput" accept="application/pdf,.pdf" class="sr-only" aria-label="Resume PDF file">
                    </div>

                    <div class="file-chip" id="fileChip" hidden>
                        <svg class="file-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        <div class="file-meta">
                            <div class="file-name" id="fileName"></div>
                            <div class="small muted" id="fileSize"></div>
                        </div>
                        <button type="button" class="btn btn-ghost btn-sm" id="btnClearFile">Change</button>
                    </div>

                    <div class="samples">
                        <span class="small muted">No resume handy? Try a fictional sample:</span>
                        <div class="sample-list" id="sampleList">
                            <button type="button" class="chip-btn" data-sample="sample-data-scientist.pdf" data-role="Data Scientist, Machine Learning, Python, SQL, Statistics, Deep Learning, Predictive Modeling" aria-pressed="false">Data scientist</button>
                            <button type="button" class="chip-btn" data-sample="sample-software-engineer.pdf" data-role="Software Engineer, Java, C++, Algorithms, Data Structures, System Design, Microservices" aria-pressed="false">Software engineer</button>
                            <button type="button" class="chip-btn" data-sample="sample-web-developer.pdf" data-role="Web Developer, HTML, CSS, JavaScript, React, Node.js, Frontend, Responsive Design" aria-pressed="false">Web developer</button>
                            <button type="button" class="chip-btn" data-sample="sample-junior-developer.pdf" data-role="Web Developer, HTML, CSS, JavaScript, React, Node.js, Frontend, Responsive Design" aria-pressed="false">Junior developer</button>
                        </div>
                    </div>
                </div>

                <div class="step">
                    <h2 class="step-title"><span class="step-num" aria-hidden="true">2</span>Pick the target job</h2>
                    <div class="field">
                        <label class="label" for="jdText">Paste the job description</label>
                        <textarea id="jdText" class="textarea" rows="5" maxlength="20000" placeholder="Paste the responsibilities and requirements from the job posting…"></textarea>
                    </div>
                    <div class="divider-text">or</div>
                    <div class="field">
                        <label class="label" for="rolePreset">Start from a role preset</label>
                        <select id="rolePreset" class="select">
                            <%- include('partials/role-options') %>
                        </select>
                    </div>
                </div>

                <div class="step">
                    <button type="submit" class="btn btn-primary btn-block" id="btnAnalyze" disabled>Analyze resume</button>
                    <p class="hint" id="analyzeHint">Add a resume and a job to get a match score.</p>
                    <div class="progress" id="progress" hidden>
                        <span class="small muted" id="progressText">Analyzing…</span>
                        <div class="progress-track"><div class="progress-bar"></div></div>
                    </div>
                    <div class="alert alert-error" id="alertBox" role="alert" hidden></div>
                </div>
            </form>

            <section class="card" id="historyCard" aria-labelledby="historyTitle" hidden>
                <h2 class="card-title" id="historyTitle">Your recent evaluations</h2>
                <p class="small muted" id="historyNote"></p>
                <ul class="history-list" id="historyList"></ul>
                <button type="button" class="btn btn-danger btn-sm" id="btnDeleteHistory" style="margin-top:0.9rem">Delete my saved data</button>
            </section>
        </div>

        <!-- ── Results ────────────────────────────────────────────── -->
        <div class="results-col">
            <section class="card empty" id="emptyState">
                <div class="empty-icon" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><polyline points="9 15 11 17 15 13"/></svg>
                </div>
                <h2>Your results will appear here</h2>
                <p>Add a resume and the job you're targeting, then run the analysis.</p>
                <div class="steps">
                    <div><b>Match score</b><span>How much of the job's important vocabulary your resume covers.</span></div>
                    <div><b>Keyword gaps</b><span>The high-value terms from the posting you haven't mentioned.</span></div>
                    <div><b>ATS checklist</b><span>Contact details, sections, length and measurable results.</span></div>
                </div>
            </section>

            <div id="resultsWrap" hidden>
                <section class="card card-ink" aria-labelledby="summaryTitle">
                    <div class="summary">
                        <div class="score-ring" id="scoreRing" role="img" aria-label="Match score">
                            <svg width="132" height="132" viewBox="0 0 132 132" aria-hidden="true">
                                <circle class="ring-track" cx="66" cy="66" r="56" fill="none" stroke-width="12"/>
                                <circle class="ring-value" id="ringValue" cx="66" cy="66" r="56" fill="none" stroke-width="12" stroke-dasharray="351.86" stroke-dashoffset="351.86"/>
                            </svg>
                            <div class="ring-label">
                                <span class="ring-num" id="ringNum">–</span>
                                <span class="ring-sub" id="ringSub">match</span>
                            </div>
                        </div>
                        <div>
                            <h2 id="summaryTitle"><span id="ratingText">Analysis</span> <span class="badge" id="ratingBadge" hidden></span></h2>
                            <p class="target" id="targetText"></p>
                            <dl class="facts">
                                <div class="fact"><dt>File</dt><dd id="factFile">–</dd></div>
                                <div class="fact"><dt>Likely field</dt><dd id="factCategory">–</dd></div>
                                <div class="fact"><dt>Length</dt><dd id="factLength">–</dd></div>
                            </dl>
                        </div>
                    </div>
                </section>

                <section class="card tabs-card" id="resultsPanel">
                    <div class="tablist" role="tablist" aria-label="Analysis results">
                        <button class="tab" role="tab" id="tab-overview-btn" aria-selected="true" aria-controls="tab-overview" data-tab="tab-overview">Overview</button>
                        <button class="tab" role="tab" id="tab-radar-btn" aria-selected="false" aria-controls="tab-radar" data-tab="tab-radar" tabindex="-1">Skill radar</button>
                        <button class="tab" role="tab" id="tab-sections-btn" aria-selected="false" aria-controls="tab-sections" data-tab="tab-sections" tabindex="-1">Resume sections</button>
                        <button class="tab" role="tab" id="tab-matcher-btn" aria-selected="false" aria-controls="tab-matcher" data-tab="tab-matcher" tabindex="-1">Try another job</button>
                        <button class="tab" role="tab" id="tab-text-btn" aria-selected="false" aria-controls="tab-text" data-tab="tab-text" tabindex="-1">Extracted text</button>
                    </div>

                    <!-- Overview -->
                    <div class="tabpanel" role="tabpanel" id="tab-overview" aria-labelledby="tab-overview-btn">
                        <div id="overviewKeywords">
                            <h3 class="section-title">Keywords from the job</h3>
                            <div class="kw-legend"><span>✓ in your resume</span><span>✕ missing</span></div>
                            <div class="kw-wrap" id="kwWrap"></div>
                        </div>
                        <div id="overviewSuggestions">
                            <h3 class="section-title">What to improve</h3>
                            <ul class="suggestions" id="suggestionList"></ul>
                        </div>
                        <h3 class="section-title">ATS readiness checklist</h3>
                        <ul class="checklist" id="checkList"></ul>
                    </div>

                    <!-- Radar -->
                    <div class="tabpanel" role="tabpanel" id="tab-radar" aria-labelledby="tab-radar-btn" hidden>
                        <p class="muted small" id="radarIntro">Each axis shows how much of the job's key vocabulary appears in that part of your resume.</p>
                        <div class="radar-box" id="radarMount"></div>
                        <table class="dim-table">
                            <caption class="sr-only">Score by dimension</caption>
                            <thead><tr><th scope="col">Dimension</th><th scope="col">Score</th><th scope="col"></th></tr></thead>
                            <tbody id="dimBody"></tbody>
                        </table>
                    </div>

                    <!-- Sections -->
                    <div class="tabpanel" role="tabpanel" id="tab-sections" aria-labelledby="tab-sections-btn" hidden>
                        <p class="muted small">This is how an automated parser reads your resume. If a section is missing here, an ATS may not find it either.</p>
                        <div class="sections-grid" id="sectionsGrid" style="margin-top:1rem"></div>
                    </div>

                    <!-- Matcher -->
                    <div class="tabpanel" role="tabpanel" id="tab-matcher" aria-labelledby="tab-matcher-btn" hidden>
                        <p class="muted small">Re-score this same resume against a different job without uploading it again.</p>
                        <div class="field" style="margin-top:1rem">
                            <label class="label" for="matchPreset">Role preset</label>
                            <select id="matchPreset" class="select">
                                <%- include('partials/role-options') %>
                            </select>
                        </div>
                        <div class="field">
                            <label class="label" for="matchJd">Job description</label>
                            <textarea id="matchJd" class="textarea" rows="6" maxlength="20000" placeholder="Paste another job description…"></textarea>
                        </div>
                        <button type="button" class="btn btn-primary" id="btnMatch" style="margin-top:1rem">Score against this job</button>
                    </div>

                    <!-- Extracted text -->
                    <div class="tabpanel" role="tabpanel" id="tab-text" aria-labelledby="tab-text-btn" hidden>
                        <div class="viewer">
                            <header><span>Text extracted from your PDF</span><button type="button" class="btn btn-secondary btn-sm" id="btnCopyText">Copy</button></header>
                            <pre id="rawText"></pre>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </div>

    <aside class="card cta-card" aria-label="Apply by email">
        <div>
            <h2>Found a hiring post on LinkedIn?</h2>
            <p class="muted small">Paste it and get the role, deadline and email address pulled out, plus a short application email you can review and send.</p>
        </div>
        <a class="btn btn-primary" href="/apply">Draft an application email</a>
    </aside>

    <section class="live-jobs" id="live-jobs" aria-labelledby="liveJobsTitle">
        <div class="live-head">
            <div>
                <h2 id="liveJobsTitle">Live job openings</h2>
                <p class="muted small" id="liveJobsLead">Fresh postings pulled from several public job boards. Analyze a resume above to rank them by how well you match.</p>
            </div>
            <button type="button" class="btn btn-secondary btn-sm" id="btnRefreshLive">Refresh</button>
        </div>

        <div class="live-bar">
        <form class="live-toolbar" id="liveForm" role="search">
            <input id="liveQuery" class="input" type="search" aria-label="Search jobs" maxlength="100" placeholder="Search title, skill or company, e.g. python, data analyst">
            <label class="toggle"><input type="checkbox" id="liveRemote"> Remote only</label>
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
        </div>

        <div class="quick-chips" id="quickChips" aria-label="Quick searches">
            <button type="button" class="chip-btn" data-q="">All jobs</button>
            <button type="button" class="chip-btn" data-q="software engineer">Software</button>
            <button type="button" class="chip-btn" data-q="data">Data &amp; AI</button>
            <button type="button" class="chip-btn" data-q="designer">Design</button>
            <button type="button" class="chip-btn" data-q="marketing">Marketing</button>
            <button type="button" class="chip-btn" data-q="sales">Sales</button>
            <button type="button" class="chip-btn" data-q="product manager">Product</button>
            <button type="button" class="chip-btn" data-q="customer support">Support</button>
            <button type="button" class="chip-btn" data-q="devops">DevOps</button>
        </div>
        <div class="source-chips" id="sourceChips" aria-label="Job sources"></div>
        <p class="live-status" id="liveStatus" role="status" aria-live="polite"></p>
        <div class="jobs-list" id="liveList"></div>
        <button type="button" class="btn btn-secondary btn-block" id="btnMoreLive" style="margin-top:1rem" hidden>Show more</button>
    </section>
</main>

<%- include('partials/footer') %>
<script src="<%= asset('/match-visualizer.bundle.js') %>" defer></script>
<script src="<%= asset('/js/app.js') %>" defer></script>
</body>
</html>
