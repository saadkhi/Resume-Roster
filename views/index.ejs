<%- include('partials/head', { pageTitle: 'Resume Rater', pageDescription: 'Career Intelligence & ATS Resume Rater — TF-IDF cosine match, competency radar, CV section parser.', includeSupabase: true }) %>
<%- include('partials/header', { showMainNav: true }) %>
    <!-- Main Workspace -->
    <main class="main-container site-container" id="main-content" role="main">
        <!-- Screen-reader live region for upload/parse status announcements -->
        <div id="srAnnouncer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
        <!-- Hero Section -->
        <div class="hero-section">
            <div>
                <h1 class="hero-title">Career Intelligence & ATS Resume Rater</h1>
                <div class="hero-subtitle">
                    <span>TF-IDF Vector Space</span>
                    <span>·</span>
                    <span>Multi-Dimensional Competency Fit</span>
                    <span>·</span>
                    <span>Automated CV Section Parser</span>
                </div>
            </div>
            <div class="hero-meta-strip">
                <span class="hero-meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    20 Standard Industry Roles
                </span>
                <span style="color: var(--border-hairline);">·</span>
                <span class="hero-meta-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563eb" strokeWidth="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    Real-Time Cosine Scoring
                </span>
            </div>
        </div>

        <!-- Split-Pane Workspace -->
        <div class="workspace-grid">
            <!-- Left Panel: Upload & Job Target Specification -->
            <section class="surface-card" id="upload-section" aria-labelledby="upload-section-heading">
                <div class="card-header-row">
                    <div>
                        <h2 class="card-title" id="upload-section-heading">Resume & Job Specification</h2>
                        <p class="card-caption">Upload candidate document or test with industry samples</p>
                    </div>
                    <span class="file-size" id="uploadStatusBadge">Ready</span>
                </div>

                <!-- Fallback Form for Standard HTML POST /upload -->
                <form id="uploadForm" action="/upload" method="post" enctype="multipart/form-data">
                    <!-- Interactive Dropzone -->
                    <div class="dropzone-container" id="dropzone" aria-describedby="dropzone-hint">
                        <input type="file" id="resumeFileInput" name="resume" accept=".pdf,application/pdf" class="sr-only" aria-label="Upload PDF resume file">
                        <div class="dropzone-icon">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"></path>
                                <path d="M12 12v9"></path>
                                <path d="m16 16-4-4-4 4"></path>
                            </svg>
                        </div>
                        <p class="dropzone-headline">Drag & drop candidate PDF resume</p>
                        <p class="dropzone-helper" id="dropzone-hint">Standard PDF files (.pdf) up to 4MB</p>
                        <button type="button" class="browse-cta" id="btnBrowseFile" aria-label="Browse for PDF file to upload">Browse PDF Document</button>
                    </div>

                    <!-- Selected File Metadata Card -->
                    <div class="selected-file-card" id="selectedFileCard">
                        <div class="selected-file-info">
                            <div class="file-icon-box">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                            </div>
                            <div class="file-meta-text">
                                <p class="file-name" id="selectedFileName">filename.pdf</p>
                                <p class="file-size" id="selectedFileSize">0 KB</p>
                            </div>
                        </div>
                        <button type="button" class="btn-remove" id="btnRemoveFile">Change</button>
                    </div>

                    <!-- Quick Sample Resumes Picker -->
                    <div class="samples-strip">
                        <div class="samples-header-row">
                            <span class="samples-label">Quick Test Candidates:</span>
                            <span class="card-caption">Click to auto-parse</span>
                        </div>
                        <div class="sample-chips-grid">
                            <button type="button" class="sample-chip active" data-sample="Saads_CV_Resume.pdf" data-role="Data Scientist, Machine Learning, Python, SQL, Statistics, Modeling">Saad Ali (ML/Data)</button>
                            <button type="button" class="sample-chip" data-sample="resume1.pdf" data-role="Software Engineer, Java, C++, Algorithms, System Design">Sample Resume 1</button>
                            <button type="button" class="sample-chip" data-sample="resume2.pdf" data-role="Web Developer, HTML, CSS, JavaScript, React, Node.js">Sample Resume 2</button>
                            <button type="button" class="sample-chip" data-sample="Saad_Ali_ResumeCV_Old.pdf" data-role="Python Developer, Django, Flask, MySQL, REST APIs">Saad Ali (Old CV)</button>
                        </div>
                    </div>

                    <!-- Target Job Description Accordion (20 Complete Roles) -->
                    <div class="optional-jd-section">
                        <div class="section-toggle-header" id="jdToggleHeader">
                            <span class="section-toggle-title">Target Job Role & Requirements</span>
                            <svg class="section-toggle-chevron" id="jdChevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </div>

                        <div class="jd-fields-wrap" id="jdFieldsWrap">
                            <div>
                                <label class="input-label" for="jobKeywordsSelect">Select from 20 Industry Role Presets:</label>
                                <select id="jobKeywordsSelect" name="job_keywords" class="input-select">
                                <%- include('partials/role-options') %>
                                </select>
                            </div>

                            <div>
                                <label class="input-label" for="jobDescriptionTextarea">Target Job Description Text / Responsibilities:</label>
                                <textarea id="jobDescriptionTextarea" name="job_description_text" class="input-textarea" rows="3" placeholder="Enter target responsibilities, qualifications, and core competencies..."></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <div class="action-row">
                        <button type="button" class="btn-primary" id="btnParseResume" aria-describedby="alertBox">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="17 8 12 3 7 8"></polyline>
                                <line x1="12" y1="3" x2="12" y2="15"></line>
                            </svg>
                            <span id="btnParseText">Evaluate & Parse Resume</span>
                        </button>
                    </div>

                    <!-- Progress Indicator -->
                    <div class="progress-container" id="progressContainer" role="status" aria-live="polite" aria-label="Upload progress">
                        <div class="progress-header">
                            <span id="progressStepText">Extracting text layers & parsing vectors...</span>
                            <span class="file-size" id="progressPercent">Processing</span>
                        </div>
                        <div class="progress-bar-track">
                            <div class="progress-bar-fill"></div>
                        </div>
                    </div>

                    <div class="alert-box" id="alertBox" role="alert" aria-live="assertive" aria-atomic="true"></div>
                </form>
            </section>

            <!-- Right Panel: Live Career Intelligence Dashboard -->
            <div class="dashboard-viewport">
                <!-- Top Metric Scorecards -->
                <div class="metrics-banner-grid">
                    <div class="metric-card">
                        <div class="metric-card-header">
                            <span>Predicted Category</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                        </div>
                        <div class="metric-card-value" id="resCategory">Data Scientist</div>
                        <div class="metric-card-caption" id="resFilename">Saads_CV_Resume.pdf</div>
                    </div>

                    <div class="metric-card">
                        <div class="metric-card-header">
                            <span>Match Rating</span>
                            <span class="status-badge high" role="status" id="resMatchBadge" aria-label="Match rating: High Match">High Match</span>
                        </div>
                        <div class="metric-card-value" id="resSimilarityScore">0.85</div>
                        <div class="metric-card-caption" id="resTargetRoleKicker">vs. Data Scientist Benchmark</div>
                    </div>

                    <div class="metric-card">
                        <div class="metric-card-header">
                            <span>Doc Scope</span>
                            <span class="file-size" id="resPages">1 page</span>
                        </div>
                        <div class="metric-card-value" id="resWords">482</div>
                        <div class="metric-card-caption"><span id="resChars">3,490</span> raw characters</div>
                    </div>
                </div>

                <!-- Main Analysis Tabs Card -->
                <div class="workspace-tabs-card" id="resultsPanel">
                    <div class="tabs-header-bar" role="tablist" aria-label="Analysis results">
                        <button type="button" class="tab-btn active" data-tab="tab-recharts"
                                role="tab" id="tabbtn-recharts"
                                aria-selected="true" aria-controls="tab-recharts" tabindex="0">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><circle cx="12" cy="12" r="10"></circle><path d="m4.93 4.93 4.24 4.24"></path><path d="m14.83 9.17 4.24-4.24"></path></svg>
                            Recharts Competency Radar
                        </button>
                        <button type="button" class="tab-btn" data-tab="tab-sections"
                                role="tab" id="tabbtn-sections"
                                aria-selected="false" aria-controls="tab-sections" tabindex="-1">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                            Extracted CV Sections
                        </button>
                        <button type="button" class="tab-btn" data-tab="tab-matcher"
                                role="tab" id="tabbtn-matcher"
                                aria-selected="false" aria-controls="tab-matcher" tabindex="-1">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            Role Match Evaluator
                        </button>
                        <button type="button" class="tab-btn" data-tab="tab-jobs"
                                role="tab" id="tabbtn-jobs"
                                aria-selected="false" aria-controls="tab-jobs" tabindex="-1">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                            Job Listings
                            <span class="tab-counter-badge" id="jobsTabCounter" aria-live="polite">12</span>
                        </button>
                        <button type="button" class="tab-btn" data-tab="tab-cleaned"
                                role="tab" id="tabbtn-cleaned"
                                aria-selected="false" aria-controls="tab-cleaned" tabindex="-1">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                            Cleaned Tokens
                        </button>
                        <button type="button" class="tab-btn" data-tab="tab-raw"
                                role="tab" id="tabbtn-raw"
                                aria-selected="false" aria-controls="tab-raw" tabindex="-1">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" focusable="false"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                            Raw PDF Layers
                        </button>
                    </div>

                    <div class="tab-content-area">
                        <!-- Tab 0: Recharts Radar -->
                        <div class="tab-pane active" id="tab-recharts" role="tabpanel" aria-labelledby="tabbtn-recharts">
                            <div id="recharts-match-container"></div>
                            <!-- Text alternative for radar chart (WCAG 1.1.1) -->
                            <div role="region" id="radarAltBlock" aria-label="Competency radar data table">
                                <p class="radar-alt-caption sr-only">Match competency scores — same data as radar chart above</p>
                                <table class="radar-alt-table sr-only" id="radarAltTable" aria-label="Match competency scores">
                                    <thead><tr><th scope="col">Dimension</th><th scope="col">Your Score</th><th scope="col">Target</th></tr></thead>
                                    <tbody id="radarAltTableBody">
                                        <tr><td>Cosine Fit</td><td>85</td><td>100</td></tr>
                                        <tr><td>Key Skills</td><td>78</td><td>100</td></tr>
                                        <tr><td>Keywords</td><td>70</td><td>100</td></tr>
                                        <tr><td>Projects</td><td>65</td><td>100</td></tr>
                                        <tr><td>Domain Scope</td><td>80</td><td>100</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Tab 1: Extracted Sections -->
                        <div class="tab-pane" id="tab-sections" role="tabpanel" aria-labelledby="tabbtn-sections">
                            <div class="sections-grid">
                                <div class="section-box">
                                    <div class="section-box-header">
                                        <span class="section-box-name">Education</span>
                                        <button type="button" class="btn-copy-section" data-target="sec-education">Copy</button>
                                    </div>
                                    <div class="section-box-content" id="sec-education">Bachelor of Science in Software Engineering, FAST-NUCES (2021 - 2025). Relevant coursework: Machine Learning, Data Structures, Operating Systems, Computer Vision.</div>
                                </div>

                                <div class="section-box">
                                    <div class="section-box-header">
                                        <span class="section-box-name">Work Experience</span>
                                        <button type="button" class="btn-copy-section" data-target="sec-experience">Copy</button>
                                    </div>
                                    <div class="section-box-content" id="sec-experience">Machine Learning Intern & Software Engineering Researcher. Developed computer vision algorithms with OpenCV and Flask, built feature extraction pipelines, optimized neural models for latency.</div>
                                </div>

                                <div class="section-box">
                                    <div class="section-box-header">
                                        <span class="section-box-name">Technical Skills</span>
                                        <button type="button" class="btn-copy-section" data-target="sec-skills">Copy</button>
                                    </div>
                                    <div class="section-box-content" id="sec-skills">Python, SQL, PyTorch, TensorFlow, Scikit-Learn, OpenCV, Flask, Django, Spiking Neural Networks (SNN), TF-IDF, Git, Docker, REST APIs, Statistics.</div>
                                </div>

                                <div class="section-box">
                                    <div class="section-box-header">
                                        <span class="section-box-name">Projects & Systems</span>
                                        <button type="button" class="btn-copy-section" data-target="sec-projects">Copy</button>
                                    </div>
                                    <div class="section-box-content" id="sec-projects">1. SNN Gesture Recognition Engine: Neuromorphic vision processor with 94.2% accuracy.
2. Resume Match Evaluator: TF-IDF vectorization with cosine similarity scoring.
3. Boiler Management Monitoring System: IoT automation dashboard in Python.</div>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 2: Live Role Match Evaluator -->
                        <div class="tab-pane" id="tab-matcher" role="tabpanel" aria-labelledby="tabbtn-matcher">
                            <div class="matcher-grid">
                                <div class="matcher-left">
                                    <div>
                                        <label class="input-label" for="liveJdPreset">Select Role Benchmark Preset:</label>
                                        <select id="liveJdPreset" class="input-select">
                                <%- include('partials/role-options') %>
                                        </select>
                                    </div>

                                    <div>
                                        <label class="input-label" for="liveJdInput">Job Description / Requirements Text:</label>
                                        <textarea id="liveJdInput" class="input-textarea" rows="5" placeholder="Paste target requirements or job posting text..."></textarea>
                                    </div>

                                    <button type="button" class="btn-primary" id="btnComputeLiveMatch" style="width: auto; align-self: flex-start;">
                                        Evaluate Match Score
                                    </button>
                                </div>

                                <div class="matcher-score-card">
                                    <div class="score-circle">
                                        <span class="score-circle-num" id="liveScoreNum">0.85</span>
                                        <span class="score-circle-lbl">SIMILARITY</span>
                                    </div>
                                    <h4 class="card-title" id="liveRatingText" style="color: #16a34a;">High Match</h4>
                                    <p class="card-caption" id="liveMatchDesc" style="margin-top: 0.35rem;">85% vector alignment against Data Scientist requirements.</p>

                                    <div style="width: 100%; margin-top: 1rem; text-align: left;">
                                        <span class="input-label">Key Term Frequency Alignment:</span>
                                        <div class="keyword-alignment-list" id="keywordAlignmentList">
                                            <div class="keyword-item matched"><span>Python</span><span class="kw-status" aria-label="Matched">Matched</span></div>
                                            <div class="keyword-item matched"><span>Machine Learning</span><span class="kw-status" aria-label="Matched">Matched</span></div>
                                            <div class="keyword-item matched"><span>SQL</span><span class="kw-status" aria-label="Matched">Matched</span></div>
                                            <div class="keyword-item matched"><span>OpenCV / Vision</span><span class="kw-status" aria-label="Matched">Matched</span></div>
                                            <div class="keyword-item missing"><span>Deep Learning Deployment</span><span class="kw-status" aria-label="Missing">Missing</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tab: Job Listings (Sample Dataset) -->
                        <div class="tab-pane" id="tab-jobs" role="tabpanel" aria-labelledby="tabbtn-jobs">
                            <div class="jobs-container">
                                <div class="jobs-toolbar">
                                    <div class="jobs-search-row">
                                        <div class="jobs-search-box">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="11" cy="11" r="8"></circle>
                                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                            </svg>
                                            <input type="text" id="jobsSearchInput" class="jobs-search-input" placeholder="Search by role, skill, company (e.g. PyTorch, Scale AI, Stripe)..." aria-label="Search jobs">
                                        </div>

                                        <div class="jobs-filter-group">
                                            <select id="jobsCategoryFilter" class="jobs-select" aria-label="Filter by Category">
                                                <option value="">All Job Categories</option>
                                                <option value="Data Science & AI">Data Science & AI</option>
                                                <option value="Software Engineering">Software Engineering</option>
                                                <option value="DevOps & Cloud">DevOps & Cloud</option>
                                                <option value="Cybersecurity">Cybersecurity</option>
                                                <option value="Database & Systems">Database & Systems</option>
                                                <option value="Product & Management">Product & Management</option>
                                            </select>

                                            <select id="jobsSortFilter" class="jobs-select" aria-label="Sort Jobs">
                                                <option value="match">Rank by ATS Match Fit</option>
                                                <option value="salary">Sort by Salary (High-Low)</option>
                                                <option value="recent">Sort by Most Recent</option>
                                            </select>

                                            <label class="jobs-remote-toggle" for="jobsRemoteToggle">
                                                <input type="checkbox" id="jobsRemoteToggle">
                                                <span>Remote Only</span>
                                            </label>

                                            <button type="button" class="btn-job-action secondary" id="btnRefreshJobs" title="Refresh Live Jobs">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                                                Refresh
                                            </button>
                                        </div>
                                    </div>

                                    <div class="jobs-status-banner" id="jobsStatusBanner">
                                        <div class="jobs-status-info">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 14 14"></polyline></svg>
                                            <span id="jobsStatusText">Loading sample job dataset...</span>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                            <span class="jobs-status-tag" id="jobsCountBadge">All Positions</span>
                                            <span class="jobs-status-tag" style="background: #f1f5f9; color: var(--text-secondary);" id="jobsSourceBadge">Sample Dataset</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dynamic Job Cards List (All Database Jobs) -->
                                <div class="jobs-cards-list" id="jobsCardsContainer">
                                    <div style="text-align: center; padding: 2.5rem; color: var(--text-muted); font-size: 0.8125rem;">
                                        <!-- Skeleton loaders reserve height to prevent CLS -->
                                        <div class="job-skeleton"><div class="skeleton-line title"></div><div class="skeleton-line company"></div><div class="skeleton-line text"></div><div class="skeleton-line tags"></div></div>
                                        <div class="job-skeleton" style="margin-top:0.75rem;"><div class="skeleton-line title"></div><div class="skeleton-line company"></div><div class="skeleton-line text short"></div><div class="skeleton-line tags"></div></div>
                                        <div class="job-skeleton" style="margin-top:0.75rem;"><div class="skeleton-line title"></div><div class="skeleton-line company"></div><div class="skeleton-line text"></div><div class="skeleton-line tags"></div></div>
                                        <p style="margin-top:1rem;">Loading job listings from sample dataset...</p>
                                    </div>
                                </div>

                                <!-- Pagination & Display Controls for Database Jobs -->
                                <div class="jobs-pagination-bar" id="jobsPaginationBar" style="display: none;">
                                    <div class="jobs-page-info" id="jobsPageInfo">Displaying positions from sample dataset</div>
                                    <div class="jobs-page-controls">
                                        <button type="button" class="btn-job-page" id="btnJobsPrevPage">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                                            Previous
                                        </button>
                                        <span class="jobs-page-current" id="jobsPageCurrent">Page 1 of 1</span>
                                        <button type="button" class="btn-job-page" id="btnJobsNextPage">
                                            Next
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
                                        </button>
                                        <button type="button" class="btn-job-page active-toggle" id="btnJobsToggleShowAll">Display All Positions</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tab 3: Cleaned Tokens -->
                        <div class="tab-pane" id="tab-cleaned" role="tabpanel" aria-labelledby="tabbtn-cleaned">
                            <div class="text-viewer-card">
                                <div class="viewer-toolbar">
                                    <span class="card-caption">Preprocessed token stream used for TF-IDF vectorization</span>
                                    <button type="button" class="btn-copy-section" id="btnCopyCleaned">Copy Cleaned Text</button>
                                </div>
                                <pre class="viewer-code-pre" id="cleanedTextPre">saad ather ali summary third year software engineering student passionate cybersecurity malware analysis seeking software engineering machine learning internship education bachelor science software engineering fast nuces karachi courses machine learning artificial intelligence operating systems technical skills python sql opencv flask django pytorch tensorflow spiking neural networks rest apis projects snn gesture recognition engine neuromorphic vision processor accuracy resume match evaluator tf idf vectorization cosine similarity boiler management system iot automation dashboard</pre>
                            </div>
                        </div>

                        <!-- Tab 4: Raw PDF Layers -->
                        <div class="tab-pane" id="tab-raw" role="tabpanel" aria-labelledby="tabbtn-raw">
                            <div class="text-viewer-card">
                                <div class="viewer-toolbar">
                                    <span class="card-caption">Exact raw text extracted from PDF stream layers</span>
                                    <button type="button" class="btn-copy-section" id="btnCopyRaw">Copy Raw Text</button>
                                </div>
                                <pre class="viewer-code-pre" id="rawTextPre">SAAD ATHER ALI
Software Engineering & Machine Learning Candidate
Email: candidate@example.com | Karachi, Pakistan

