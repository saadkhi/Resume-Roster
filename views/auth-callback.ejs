<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authenticating... - Resume Rater</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            font-family: 'Inter', sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            text-align: center;
        }
        .spinner {
            width: 48px;
            height: 48px;
            border: 4px solid rgba(59, 130, 246, 0.2);
            border-top-color: #3b82f6;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin-bottom: 1.5rem;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem; }
        p { color: #94a3b8; font-size: 0.875rem; }
    </style>
</head>
<body>
    <div class="spinner"></div>
    <h2>Authenticating with Supabase...</h2>
    <p>Completing secure sign in and preparing your free ATS dashboard.</p>

    <script>
        const SUPABASE_URL = '<%= locals.supabaseUrl || "https://medvnbynodmsjaqvtjzl.supabase.co" %>';
        const SUPABASE_ANON_KEY = '<%= locals.supabaseAnonKey || "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.placeholder" %>';

        async function processAuth() {
            try {
                if (window.supabase && SUPABASE_URL) {
                    const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
                    const { data: { session }, error } = await client.auth.getSession();
                    if (session && session.user) {
                        await fetch('/api/auth/sync', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                id: session.user.id,
                                email: session.user.email,
                                name: session.user.user_metadata?.full_name || session.user.user_metadata?.name || session.user.email?.split('@')[0],
                                avatar: session.user.user_metadata?.avatar_url || ''
                            })
                        });
                    }
                }
            } catch (err) {
                console.warn('OAuth session processing notice:', err.message);
            } finally {
                window.location.href = '/';
            }
        }

        processAuth();
    </script>
</body>
</html>
