<%- include('partials/head', { pageTitle: 'Signing you in' }) %>
<%- include('partials/header') %>

<main id="main-content" class="container" data-page="auth-callback">
    <div class="center-screen" role="status" aria-live="polite">
        <div class="spinner" id="callbackSpinner" aria-hidden="true"></div>
        <h1 style="font-size:1.25rem">Signing you in…</h1>
        <p class="muted" id="callbackMessage">This only takes a moment.</p>
        <p style="margin-top:1rem" id="callbackBack" hidden><a class="btn btn-secondary" href="/auth">Back to sign in</a></p>
    </div>
</main>

<%- include('partials/footer') %>
<script src="<%= asset('/vendor/supabase.js') %>" defer></script>
<script src="<%= asset('/js/auth.js') %>" defer></script>
</body>
</html>
