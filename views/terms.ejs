            --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
            --layout-max-width: 960px;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: var(--font-sans);
            background-color: var(--bg-canvas);
            color: var(--text-primary);
            line-height: 1.65;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .header {
            background: var(--surface-card);
            border-bottom: 1px solid var(--border-hairline);
            padding: 1rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 20;
        }
        .header-inner {
            max-width: var(--layout-max-width);
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 800;
            font-size: 1.1rem;
        }
        .brand svg { color: var(--accent-primary); }
        .nav-back {
            text-decoration: none;
            color: var(--accent-primary);
            font-size: 0.875rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }
        .nav-back:hover { text-decoration: underline; }
        .content-card {
            max-width: var(--layout-max-width);
            width: 100%;
            margin: 2.5rem auto;
            background: var(--surface-card);
            border: 1px solid var(--border-hairline);
            border-radius: 12px;
            padding: 2.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
            flex: 1;
        }
        @media (max-width: 640px) {
            .content-card { padding: 1.5rem; margin: 1.25rem auto; }
        }
        .badge {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            background: #eff6ff;
            color: var(--accent-primary);
            padding: 0.2rem 0.6rem;
            border-radius: 9999px;
            margin-bottom: 0.75rem;
        }
        h1 {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.025em;
            margin-bottom: 0.5rem;
            color: var(--text-primary);
        }
        .meta-date {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border-hairline);
        }
        h2 {
            font-size: 1.25rem;
            font-weight: 700;
            margin: 1.75rem 0 0.75rem;
            color: var(--text-primary);
        }
        p {
            color: var(--text-secondary);
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }
        ul, ol {
            color: var(--text-secondary);
            margin-left: 1.5rem;
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }
        li { margin-bottom: 0.4rem; }
        .notice-box {
            background: #f8fafc;
            border-left: 4px solid var(--accent-primary);
            padding: 1rem 1.25rem;
            border-radius: 0 8px 8px 0;
            margin: 1.5rem 0;
            font-size: 0.9rem;
            color: var(--text-secondary);
        }
        .footer {
            background: var(--surface-card);
            border-top: 1px solid var(--border-hairline);
            padding: 1.5rem;
            font-size: 0.8125rem;
            color: var(--text-muted);
            text-align: center;
        }
        .footer-links {
            margin-top: 0.5rem;
            display: flex;
            justify-content: center;
            gap: 1.25rem;
            flex-wrap: wrap;
        }
        .footer-links a {
            color: var(--text-secondary);
            text-decoration: none;
        }
        .footer-links a:hover {
            color: var(--accent-primary);
        }
    </style>
</head>
