<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
        <div class="container">
            <a href="/" class="brand" aria-label="Resume Rater home">
                <span class="brand-mark" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/></svg>
                </span>
                Resume Rater
            </a>

            <nav class="nav" id="siteNav" aria-label="Main">
                <a href="/"<%- locals.navActive === 'home' ? ' aria-current="page"' : '' %>>Resume checker</a>
                <a href="/#live-jobs">Live jobs</a>
                <a href="/apply"<%- locals.navActive === 'apply' ? ' aria-current="page"' : '' %>>Apply by email</a>
                <a href="/privacy">Privacy</a>
                <a href="/contact">Contact</a>
            </nav>

            <span class="header-spacer"></span>

            <div class="user-menu" id="userMenu">
                <% if (locals.currentUser) { %>
                    <a class="user-link" href="/account" aria-label="Your account">
                        <span class="avatar" aria-hidden="true"><%= (currentUser.name || currentUser.email || '?').charAt(0).toUpperCase() %></span>
                        <span class="user-name"><%= currentUser.name || currentUser.email %></span>
                    </a>
                    <button type="button" class="btn btn-secondary btn-sm" id="btnSignOut">Sign out</button>
                <% } else if (locals.authEnabled) { %>
                    <a href="/auth" class="btn btn-secondary btn-sm">Sign in</a>
                <% } %>
            </div>

            <button type="button" class="btn btn-ghost btn-sm menu-btn" id="btnMenu" aria-expanded="false" aria-controls="siteNav" aria-label="Toggle menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
        </div>
    </header>

    <nav class="tabbar" aria-label="Primary">
        <a href="/"<%- locals.navActive === 'home' ? ' aria-current="page"' : '' %>>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>Home</a>
        <a href="/#live-jobs">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/></svg>Jobs</a>
        <a href="/apply"<%- locals.navActive === 'apply' ? ' aria-current="page"' : '' %>>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>Apply</a>
        <a href="<%= locals.currentUser ? '/account' : '/auth' %>"<%- locals.navActive === 'profile' ? ' aria-current="page"' : '' %>>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 14.5-4 16 0"/></svg>Profile</a>
    </nav>
