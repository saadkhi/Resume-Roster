<%- include('partials/head', { pageTitle: 'Contact' }) %>
<%- include('partials/header') %>

<main id="main-content" class="container">
    <div class="page-narrow prose">
        <h1>Contact us</h1>
        <p class="meta">Questions, bug reports or data requests. We reply by email.</p>

        <% if (locals.status) { %>
            <div class="alert <%= status.ok ? 'alert-success' : 'alert-error' %>" role="alert" style="margin-top:0"><%= status.text %></div>
        <% } %>

        <form class="card" method="post" action="/contact" style="margin-top:1.25rem">
            <div class="field">
                <label class="label" for="name">Name <span class="muted">(optional)</span></label>
                <input class="input" id="name" name="name" type="text" maxlength="100" autocomplete="name" value="<%= form.name %>">
            </div>
            <div class="field">
                <label class="label" for="email">Email</label>
                <input class="input" id="email" name="email" type="email" maxlength="254" autocomplete="email" required value="<%= form.email %>">
            </div>
            <div class="field">
                <label class="label" for="subject">Topic</label>
                <select class="select" id="subject" name="subject">
                    <% [['general','General question'],['bug','Report a problem'],['data','Data access or deletion request'],['feedback','Feedback']].forEach(function (o) { %>
                        <option value="<%= o[0] %>" <%= form.subject === o[0] ? 'selected' : '' %>><%= o[1] %></option>
                    <% }); %>
                </select>
            </div>
            <div class="field">
                <label class="label" for="message">Message</label>
                <textarea class="textarea" id="message" name="message" rows="6" maxlength="5000" required><%= form.message %></textarea>
            </div>
            <div class="honeypot" aria-hidden="true">
                <label>Leave this field empty <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:1.25rem">Send message</button>
        </form>

        <% if (locals.contactEmail) { %>
            <p class="small" style="margin-top:1rem">You can also write to <a href="mailto:<%= contactEmail %>"><%= contactEmail %></a>.</p>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
</body>
</html>
