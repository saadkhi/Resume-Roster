<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - Resume Rater Support</title>
    <meta name="description" content="Get in touch with the Resume Rater support team for customer inquiries, billing, and ATS evaluation feedback.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-canvas: #f8fafc;
            --surface-card: #ffffff;
            --surface-subtle: #f1f5f9;
            --border-hairline: #e2e8f0;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --accent-primary: #2563eb;
            --accent-primary-hover: #1d4ed8;
            --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
            --layout-max-width: 860px;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: var(--font-sans);
            background-color: var(--bg-canvas);
            color: var(--text-primary);
            line-height: 1.65;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .header {
            background: var(--surface-card);
            border-bottom: 1px solid var(--border-hairline);
            padding: 1rem 1.5rem;
            position: sticky;
            top: 0;
            z-index: 20;
        }
        .header-inner {
            max-width: var(--layout-max-width);
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 800;
            font-size: 1.1rem;
        }
        .brand svg { color: var(--accent-primary); }
        .nav-back {
            text-decoration: none;
            color: var(--accent-primary);
            font-size: 0.875rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }
        .nav-back:hover { text-decoration: underline; }
        .content-card {
            max-width: var(--layout-max-width);
            width: 100%;
            margin: 2.5rem auto;
            background: var(--surface-card);
            border: 1px solid var(--border-hairline);
            border-radius: 12px;
            padding: 2.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
            flex: 1;
        }
        @media (max-width: 640px) {
            .content-card { padding: 1.5rem; margin: 1.25rem auto; }
        }
        .badge {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            background: #eff6ff;
            color: var(--accent-primary);
            padding: 0.2rem 0.6rem;
            border-radius: 9999px;
            margin-bottom: 0.75rem;
        }
        h1 {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.025em;
            margin-bottom: 0.5rem;
            color: var(--text-primary);
        }
        .subtitle {
            color: var(--text-secondary);
            font-size: 1rem;
            margin-bottom: 2rem;
        }
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.75rem;
            margin-bottom: 2rem;
        }
        @media (max-width: 720px) {
            .contact-grid { grid-template-columns: 1fr; }
        }
        .contact-card {
            background: #f8fafc;
            border: 1px solid var(--border-hairline);
            border-radius: 10px;
            padding: 1.25rem;
        }
        .contact-card-title {
            font-weight: 700;
            font-size: 0.95rem;
            color: var(--text-primary);
            margin-bottom: 0.35rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .contact-card-body {
            font-size: 0.875rem;
            color: var(--text-secondary);
        }
        .contact-card-body a {
            color: var(--accent-primary);
            font-weight: 600;
            text-decoration: none;
        }
        .contact-card-body a:hover { text-decoration: underline; }
        .form-group {
            margin-bottom: 1.25rem;
        }
        label {
            display: block;
            font-size: 0.8125rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.4rem;
        }
        input[type="text"], input[type="email"], select, textarea {
            width: 100%;
            padding: 0.7rem 0.85rem;
            border: 1px solid var(--border-hairline);
            border-radius: 6px;
            font-family: var(--font-sans);
            font-size: 0.875rem;
            color: var(--text-primary);
            background: #ffffff;
            transition: border-color 0.15s ease;
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
        }
        textarea { resize: vertical; min-height: 120px; }
        .btn-submit {
            background: var(--accent-primary);
            color: #ffffff;
            font-weight: 600;
            font-size: 0.875rem;
            padding: 0.75rem 1.5rem;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            transition: background 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }
        .btn-submit:hover {
            background: var(--accent-primary-hover);
        }
        .alert-box {
            padding: 1rem 1.25rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .alert-box.success {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #166534;
        }
        .alert-box.error {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
        }
        .footer {
            background: var(--surface-card);
            border-top: 1px solid var(--border-hairline);
            padding: 1.5rem;
            font-size: 0.8125rem;
            color: var(--text-muted);
            text-align: center;
        }
        .footer-links {
            margin-top: 0.5rem;
            display: flex;
            justify-content: center;
            gap: 1.25rem;
            flex-wrap: wrap;
        }
        .footer-links a {
            color: var(--text-secondary);
            text-decoration: none;
        }
        .footer-links a:hover {
            color: var(--accent-primary);
        }
    </style>
</head>
<body>
    <header class="header">
        <div class="header-inner">
            <a href="/" class="brand">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
                Resume Rater
            </a>
            <a href="/" class="nav-back">
                &larr; Back to App
            </a>
        </div>
    </header>

    <main class="content-card">
        <span class="badge">Support &amp; Feedback</span>
        <h1>Contact Us</h1>
        <p class="subtitle">Have questions about ATS evaluations, need billing assistance with Paddle, or want to report an issue? We're here to help.</p>

        <% if (locals.submitted && locals.success) { %>
            <div class="alert-box success">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <div>
                    <strong>Message received!</strong> Thank you for reaching out. We will get back to your email at <em><%= locals.senderEmail || '' %></em> shortly.
                </div>
            </div>
        <% } %>

        <% if (locals.error) { %>
            <div class="alert-box error">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                <div><%= locals.error %></div>
            </div>
        <% } %>

        <div class="contact-grid">
            <div class="contact-card">
                <div class="contact-card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    Direct Email Support
                </div>
                <div class="contact-card-body">
                    Write directly to our engineering &amp; support desk:<br>
                    <a href="mailto:saadalioffic@gmail.com">saadalioffic@gmail.com</a>
                    <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.4rem;">
                        Average response time: &lt; 24 business hours
                    </div>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-card-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                    Direct Platform Support
                </div>
                <div class="contact-card-body">
                    For platform questions, account issues, or feature requests:<br>
                    <a href="mailto:saadalioffic@gmail.com">saadalioffic@gmail.com</a>
                    <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 0.4rem;">
                        100% Free · Prompt Developer Support
                    </div>
                </div>
            </div>
        </div>

        <form action="/contact" method="POST" id="contactForm">
            <div class="form-group">
                <label for="contactName">Your Name</label>
                <input type="text" id="contactName" name="name" placeholder="e.g. Jane Doe" required value="<%= locals.name || '' %>">
            </div>

            <div class="form-group">
                <label for="contactEmail">Your Email Address</label>
                <input type="email" id="contactEmail" name="email" placeholder="e.g. jane@example.com" required value="<%= locals.email || '' %>">
            </div>

            <div class="form-group">
                <label for="contactSubject">Topic / Category</label>
                <select id="contactSubject" name="subject" required>
                    <option value="general" <%= locals.subject === 'general' ? 'selected' : '' %>>General Question / Feedback</option>
                    <option value="account" <%= locals.subject === 'account' ? 'selected' : '' %>>Supabase Account / Sign In</option>
                    <option value="technical" <%= locals.subject === 'technical' ? 'selected' : '' %>>ATS Parsing or Radar Scoring Issue</option>
                    <option value="feature" <%= locals.subject === 'feature' ? 'selected' : '' %>>Feature Suggestion or Custom Role</option>
                </select>
            </div>

            <div class="form-group">
                <label for="contactMessage">Message</label>
                <textarea id="contactMessage" name="message" placeholder="Please describe how we can help you..." required><%= locals.message || '' %></textarea>
            </div>

            <button type="submit" class="btn-submit" id="btnSubmitContact">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                Send Support Message
            </button>
        </form>
    </main>

    <footer class="footer">
        <div>&copy; 2026 Resume Rater &bull; ATS &amp; Career Intelligence Engine</div>
        <div class="footer-links">
            <a href="/">Home</a>
            <a href="/terms">Terms of Service</a>
            <a href="/privacy">Privacy Policy</a>
            <a href="/refund">Refund Policy</a>
            <a href="/contact">Contact Us</a>
        </div>
    </footer>
</body>
</html>
